{
  "name": "civicproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "build:geometry": "tsx scripts/build-geometry.mts",
    "seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "predev": "node scripts/copy-maplibre-worker.mjs && (test -f corpus/generated/pages.json || npm run ingest)",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && npm run ingest",
    "test:e2e": "playwright test",
    "eval": "node --conditions=react-server --import tsx scripts/eval.ts",
    "check": "bash scripts/check.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.1135.0",
    "@aws-sdk/client-lambda": "^3.1135.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/client-textract": "^3.1135.0",
    "@aws-sdk/lib-dynamodb": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@cedar-policy/cedar-wasm": "^4.13.0",
    "@cedar-policy/mcp-schema-generator-wasm": "^0.6.0",
    "@google/genai": "^2.23.0",
    "@react-pdf/renderer": "^4.9.0",
    "@strands-agents/sdk": "^1.18.0",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "minisearch": "^7.2.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-use-measure": "^2.1.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dynalite": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
