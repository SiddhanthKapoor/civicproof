# CivicProof configuration. Everything is optional: with no variables set, the app runs locally
# with file storage and the rules planner (no model calls). Copy to .env.local to use.

# --- Investigator -----------------------------------------------------------
# "rules" (default, no LLM) or "bedrock" (Claude on Amazon Bedrock via Strands Agents)
CIVICPROOF_PLANNER=rules
# Bedrock model or inference profile, and the region to call it from.
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5
BEDROCK_REGION=ap-south-1
# Optional Amazon Bedrock Guardrail applied to every model call.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# AWS credentials come from the standard chain (aws configure / SSO / env / Lambda role).
# For quick local Bedrock tests you can also use a Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-south-1

# --- Storage ------------------------------------------------------------------
# local (JSON files under .data/) or dynamodb
CIVICPROOF_STORE=local
CIVICPROOF_TABLE=civicproof
# local (files under .data/blobs) or s3
CIVICPROOF_BLOBS=local
# CIVICPROOF_BUCKET=
# CIVICPROOF_DATA_DIR=.data

# --- Limits -----------------------------------------------------------------------
CIVICPROOF_MAX_RUNS_PER_CASE=5
CIVICPROOF_MAX_RUNS_PER_DAY=150
CIVICPROOF_MAX_TOOL_CALLS=40

# --- Site ------------------------------------------------------------------------
# Public URL, used for absolute link-preview (Open Graph) URLs.
# SITE_URL=https://xxxx.lambda-url.ap-south-1.on.aws

# --- Third-party courtesy --------------------------------------------------------
# Identifies the app to OpenStreetMap Nominatim (usage policy asks for contact info).
NOMINATIM_CONTACT=civicproof-hackathon
